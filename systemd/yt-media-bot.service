[Unit]
Description=YT+YA-MP3 Telegram media bot
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/yt-media-bot/telegram-token

[Service]
Type=simple
User=yt-media
Group=yt-media
ExecStart=/usr/bin/python3 /opt/yt-media-bot/bot.py
WorkingDirectory=/var/lib/yt-media-bot
LoadCredential=telegram_token:/etc/yt-media-bot/telegram-token
StateDirectory=yt-media-bot
StateDirectoryMode=0711
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/yt-media-bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=1G
CPUQuota=150%
TasksMax=96
LimitFSIZE=3221225472
LimitCORE=0

[Install]
WantedBy=multi-user.target
